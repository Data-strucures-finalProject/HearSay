# Local Docker development. Copy this file to .env in the repository root.
NODE_ENV=development
DEFAULT_ADMIN_EMAIL=admin@hearsay.com
DEFAULT_ADMIN_PASSWORD=password
API_ORIGIN=http://localhost:8080,http://localhost

# MongoDB credentials used by the database and backend containers.
MONGO_PROTOCOL=mongodb
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=hearsay
MONGO_AUTH_SOURCE=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me

# Runtime database account. It is created from the admin account above at backend startup.
MONGO_APP_USERNAME=hearsay_app
MONGO_APP_PASSWORD=replace-with-a-long-random-app-password
MONGO_APP_AUTH_SOURCE=hearsay

# Session configuration.
SESSION_SECRET=change-this-session-secret
SESSION_TTL_SECONDS=3600
SESSION_ROTATE_MS=3600000
SESSIONS_COLLECTION=expressSessions
SESSION_COOKIE_SECURE=false

# Google OAuth uses one redirect URI per frontend build.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# Spotify credentials are needed for live music search and metadata.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional credentials for the first Nginx Proxy Manager admin.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=''

# Leave blank for local development. See .env.production.example for public hosting.
CLOUDFLARE_TUNNEL_TOKEN=
