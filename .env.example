NODE_ENV=production
API_ORIGIN=http://localhost:8080,http://localhost

# MongoDB credentials used by the database and backend containers.
MONGO_PROTOCOL=mongodb
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=hearsay
MONGO_AUTH_SOURCE=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me

# Session configuration.
SESSION_SECRET=change-this-session-secret
SESSION_TTL_SECONDS=3600
SESSION_ROTATE_MS=3600000
SESSIONS_COLLECTION=expressSessions
SESSION_COOKIE_SECURE=true

# Optional external API credentials.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=