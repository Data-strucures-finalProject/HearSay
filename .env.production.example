# Public Docker deployment. Copy to .env for a new production install.
# Replace the placeholder passwords and session secret before starting.
NODE_ENV=production
API_ORIGIN=https://hearsay.gripe
DEFAULT_ADMIN_EMAIL=admin@hearsay.gripe
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Use your existing MongoDB credentials when reusing a database.
MONGO_PROTOCOL=mongodb
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=hearsay
MONGO_AUTH_SOURCE=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=replace-with-a-strong-mongodb-password
MONGO_APP_USERNAME=hearsay_app
MONGO_APP_PASSWORD=replace-with-a-long-random-app-password
MONGO_APP_AUTH_SOURCE=hearsay

# Generate a long random session signing secret.
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_TTL_SECONDS=3600
SESSION_ROTATE_MS=3600000
SESSIONS_COLLECTION=expressSessions
SESSION_COOKIE_SECURE=true

# Optional Google OAuth. Use the same client ID in both fields and register the exact callback.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_REDIRECT_URI=https://hearsay.gripe/auth/callback

# Spotify credentials are needed for live music search and metadata.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional first-run Nginx Proxy Manager admin. Single-quote passwords containing $.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=''

# Required when starting the optional cloudflared service with the tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
